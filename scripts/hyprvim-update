#!/bin/sh
# scripts/hyprvim-update
# Check for or apply HyprVim updates.
#
# Usage: hyprvim-update <op> <channel> <repo> [ref]
#   op:      check | apply
#   channel: nightly | stable | pinned
#   repo:    path to the HyprVim install directory
#   ref:     git ref to pin to (channel=pinned only)

REPO_API="uhs-robert/hyprvim"

op="$1"
channel="$2"
repo="$3"
ref="$4"
state_dir="${XDG_RUNTIME_DIR:-/tmp}/hyprvim"
prompt_lock="$state_dir/update-prompt.lock"
prompt_stamp="$state_dir/update-prompt-stamp"
prompt_cooldown=3600

mkdir -p "$state_dir" 2>/dev/null

# Show an actionable desktop notification; run cmd if accepted.
# Falls back to a passive hyprctl notify when notify-send is unavailable.
notify_action() {
  title="$1" body="$2" label="$3" cmd="$4"
  if [ "$op" = "check" ]; then
    now=$(date +%s 2>/dev/null || echo 0)
    last=$(cat "$prompt_stamp" 2>/dev/null || echo 0)
    [ "$now" -gt 0 ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt "$prompt_cooldown" ] && return
    mkdir "$prompt_lock" 2>/dev/null || return
    printf '%s\n' "$now" >"$prompt_stamp" 2>/dev/null
  fi
  if command -v notify-send >/dev/null 2>&1; then
    ACTION=$(notify-send -A "ok=$label" -u normal -t 0 "$title" "$body")
    [ "$ACTION" = "ok" ] && { sh -c "$cmd" || notify_fail "Update failed (dirty tree or no network?)."; }
  else
    hyprctl notify 1 10000 'rgb(7FA3C9)' "$title - $body"
  fi
  [ "$op" = "check" ] && rmdir "$prompt_lock" 2>/dev/null
}

# Passive failure notification.
notify_fail() {
  body="$1"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "HyprVim" "$body"
  else
    hyprctl notify 3 10000 'rgb(D9534F)' "HyprVim - $body"
  fi
}

# Single-quote a value for safe embedding in a sh -c command string.
sq() {
  printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"
}

# Remote default branch name (falls back to main).
default_branch() {
  b=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | cut -d/ -f2-)
  [ -n "$b" ] && echo "$b" || echo main
}

latest_release() {
  curl -sf "https://api.github.com/repos/$REPO_API/releases/latest" |
    jq -r '.tag_name // empty'
}

fetch_pinned() {
  git -C "$repo" fetch --tags -q 2>/dev/null
  git -C "$repo" fetch -q origin "$ref" 2>/dev/null || true
}

if [ ! -d "$repo/.git" ]; then
  [ "$op" = "apply" ] &&
    notify_fail "This install is not a git checkout. Update with pacman or your AUR helper."
  exit 0
fi

case "$op/$channel" in
check/nightly)
  git -C "$repo" fetch -q 2>/dev/null
  LOCAL=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
  REMOTE=$(git -C "$repo" rev-parse '@{u}' 2>/dev/null)
  PULL="git -C $(sq "$repo") pull --ff-only"
  if [ -z "$REMOTE" ]; then
    # Detached HEAD (e.g. after a stable-channel tag checkout): compare against
    # the remote default branch and re-attach before pulling.
    BRANCH=$(default_branch)
    REMOTE=$(git -C "$repo" rev-parse "origin/$BRANCH" 2>/dev/null)
    PULL="git -C $(sq "$repo") checkout $(sq "$BRANCH") && $PULL"
  fi
  [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ] &&
    notify_action "HyprVim" "Nightly update available." "Update now" \
      "$PULL && hyprctl reload"
  ;;
check/stable)
  LATEST=$(latest_release)
  [ -n "$LATEST" ] || exit 0
  git -C "$repo" fetch --tags -q 2>/dev/null
  git -C "$repo" merge-base --is-ancestor "$LATEST" HEAD 2>/dev/null && exit 0
  notify_action "HyprVim" "Release $LATEST available." "Update now" \
    "git -C $(sq "$repo") checkout $(sq "$LATEST") && hyprctl reload"
  ;;
check/pinned)
  fetch_pinned
  PINNED=$(git -C "$repo" rev-parse "$ref" 2>/dev/null)
  HEAD=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
  [ -n "$PINNED" ] && [ "$HEAD" != "$PINNED" ] &&
    notify_action "HyprVim" "Not at pinned ref $ref." "Restore" \
      "git -C $(sq "$repo") checkout $(sq "$ref") && hyprctl reload"
  ;;
apply/nightly)
  {
    git -C "$repo" symbolic-ref -q HEAD >/dev/null ||
      git -C "$repo" checkout "$(default_branch)"
  } &&
    git -C "$repo" pull --ff-only && hyprctl reload ||
    notify_fail "Nightly update failed (dirty tree or no network?)."
  ;;
apply/stable)
  LATEST=$(latest_release)
  [ -n "$LATEST" ] &&
    git -C "$repo" fetch --tags -q &&
    git -C "$repo" checkout "$LATEST" &&
    hyprctl reload ||
    notify_fail "Stable update failed (network or dirty tree?)."
  ;;
apply/pinned)
  fetch_pinned
  git -C "$repo" checkout "$ref" && hyprctl reload ||
    notify_fail "Checkout of pinned ref $ref failed."
  ;;
esac
